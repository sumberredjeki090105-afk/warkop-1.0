  const handleAdjustMenuRacikanSold = (menuId, delta) => {
    setInventory((prev) => {
      const targetMenu = prev.find((i) => i.id === menuId);
      if (!targetMenu) return prev;
      const oldSold = Number(targetMenu.soldCount) || 0;
      const newSold = Math.max(0, oldSold + delta);
      if (newSold === oldSold) return prev;

      const updatedMenus = prev.map((it) => (it.id === menuId ? { ...it, soldCount: newSold } : it));

      // Hitung ulang total pemakaian bahan baku dari seluruh menu racikan
      const newUsage = {};
      updatedMenus.forEach((m) => {
        if (m.isMenuRacikan && (Number(m.soldCount) || 0) > 0 && Array.isArray(m.recipe)) {
          m.recipe.forEach((r) => {
            const ingId = Number(r.ingredientId);
            newUsage[ingId] = Math.round(((newUsage[ingId] || 0) + m.soldCount * (Number(r.qty) || 0)) * 100) / 100;
          });
        }
      });

      // Potong otomatis stok akhir bahan baku yang bersangkutan
      const affectedIds = new Set((targetMenu.recipe || []).map((r) => Number(r.ingredientId)));
      return updatedMenus.map((it) => {
        if (!it.isMenuRacikan && affectedIds.has(it.id)) {
          const avail = (Number(it.stockStart) || 0) + (Number(it.stockIn) || 0) - (Number(it.stockWaste) || 0);
          const used = newUsage[it.id] || 0;
          const newEnd = Math.max(0, Math.round((avail - used) * 100) / 100);
          return { ...it, stockEnd: newEnd };
        }
        return it;
      });
    });
  };

  // Handler Update Stok Fisik
  const handlePhysicalStockChange = (itemId, field, rawValue) => {
    const cleanVal = String(rawValue).replace(',', '.');
    const numVal = Math.max(0, parseFloat(cleanVal) || 0);
    setInventory((prev) =>
      prev.map((it) => {
        if (it.id !== itemId) return it;
        const updated = { ...it, [field]: numVal };
        if (field === 'stockStart' || field === 'stockIn' || field === 'stockWaste') {
          const avail = (Number(updated.stockStart) || 0) + (Number(updated.stockIn) || 0) - (Number(updated.stockWaste) || 0);
          const usedInRecipe = recipeUsageMap[itemId]?.totalQty || 0;
          updated.stockEnd = Math.max(0, Math.round((avail - usedInRecipe) * 100) / 100);
        }
        return updated;
      })
    );
  };

