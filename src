    const histPetty = shiftHistory.reduce((s, h) => s + (Number(h.totalPettyCash) || 0), 0);

    const totalOmzet = histOmzet + shiftTotals.totalOmzet;
    const totalHpp = histHpp + shiftTotals.totalHpp;
    const grossProfit = totalOmzet - totalHpp;
    const totalPettyCash = histPetty + shiftTotals.totalPettyCash;
    const totalWorkerWages = workerSummaryList.reduce((s, w) => s + w.netWage, 0);
    const totalSinkingMonthly = sinkingFunds.reduce((s, f) => s + (Number(f.monthlyTarget) || 0), 0);
    const netProfit = grossProfit - totalPettyCash - totalWorkerWages - totalSinkingMonthly;

    return {
      totalOmzet,
      totalHpp,
      grossProfit,
      totalPettyCash,
      totalWorkerWages,
      totalSinkingMonthly,
      netProfit,
