  // ==========================================================================
  // INJEKSI OTOMATIS PWA (MANIFEST + SERVICE WORKER + BEFOREINSTALLPROMPT)
  // ==========================================================================
  useEffect(() => {
    try {
      // 1. Sematkan meta theme-color
      let metaTheme = document.querySelector('meta[name="theme-color"]');
      if (!metaTheme) {
        metaTheme = document.createElement('meta');
        metaTheme.name = 'theme-color';
        document.head.appendChild(metaTheme);
      }
      metaTheme.content = '#8B1E1E';

      // 2. Sematkan <link rel="manifest"> dinamis
      let linkManifest = document.querySelector('link[rel="manifest"]');
      if (!linkManifest) {
        linkManifest = document.createElement('link');
        linkManifest.rel = 'manifest';
        const blobManifest = new Blob([JSON.stringify(getManifestJsonObject())], { type: 'application/json' });
        linkManifest.href = URL.createObjectURL(blobManifest);
        document.head.appendChild(linkManifest);
      }

      // 3. Registrasi Service Worker
      if ('serviceWorker' in navigator) {
        navigator.serviceWorker.register('/service-worker.js').catch(() => {
          const swBlob = new Blob([SERVICE_WORKER_CODE], { type: 'application/javascript' });
          navigator.serviceWorker.register(URL.createObjectURL(swBlob)).catch(() => {});
        });
      }

      // 4. Deteksi jika sudah berjalan standalone
      if (window.matchMedia && window.matchMedia('(display-mode: standalone)').matches) {
        setIsPwaInstalled(true);
      }
    } catch {
      // Abaikan jika diblokir sandbox iframe
    }

    const handleBeforeInstall = (e) => {
      e.preventDefault();
      setDeferredPrompt(e);
    };
    const handleAppInstalled = () => {
      setIsPwaInstalled(true);
      setDeferredPrompt(null);
      showToast('✅ Aplikasi Warkop Sumber Redjeki berhasil ter-install!');
    };

    window.addEventListener('beforeinstallprompt', handleBeforeInstall);
    window.addEventListener('appinstalled', handleAppInstalled);
    return () => {
      window.removeEventListener('beforeinstallprompt', handleBeforeInstall);
      window.removeEventListener('appinstalled', handleAppInstalled);
    };
  }, []);

  const handleInstallPwaClick = async () => {
    if (deferredPrompt) {
      deferredPrompt.prompt();
      const { outcome } = await deferredPrompt.userChoice;
      if (outcome === 'accepted') {
        setDeferredPrompt(null);
      }
    } else {
      setShowPwaModal(true);
    }
  };

  // ==========================================================================
  // PENYIMPANAN LOKAL OTOMATIS
  // ==========================================================================
  useEffect(() => {
    localStorage.setItem('wsr_inventory_v19', JSON.stringify(inventory));
  }, [inventory]);

  useEffect(() => {
    localStorage.setItem('wsr_prev_closing_v19', JSON.stringify(previousShiftClosingMap));
  }, [previousShiftClosingMap]);

  useEffect(() => {
    localStorage.setItem('wsr_workers_v19', JSON.stringify(workers));
  }, [workers]);

  useEffect(() => {
    localStorage.setItem('wsr_attendance_v19', JSON.stringify(attendanceLogs));
  }, [attendanceLogs]);

  useEffect(() => {
    localStorage.setItem('wsr_sinking_v19', JSON.stringify(sinkingFunds));
  }, [sinkingFunds]);

  useEffect(() => {
    localStorage.setItem('wsr_shifts_v19', JSON.stringify(shiftHistory));
  }, [shiftHistory]);

  useEffect(() => {
    localStorage.setItem('wsr_owner_pin_v19', ownerPin);
  }, [ownerPin]);

  useEffect(() => {
    localStorage.setItem('wsr_webhook_v19', webhookUrl);
  }, [webhookUrl]);

  useEffect(() => {
    localStorage.setItem('wsr_cloud_room_v19', cloudRoom);
  }, [cloudRoom]);

  // ==========================================================================
  // MESIN SINKRONISASI CLOUD KOMPRESI (< 2KB AGAR TEMBUS NTFY.SH INSTAN)
  // ==========================================================================
  const buildCompactCloudPacket = () => {
    const compactInv = inventory.map((it) => [
      it.id,
      it.stockStart,
      it.stockIn,
      it.stockWaste,
      it.stockEnd,
      it.soldCount,
      it.cost,
      it.price,
      it.packCost || 0,
      it.minStock || 0,
      it.targetStock || 0,
      it.name,
      it.recipe || [],
    ]);
    return {
      v: 19,
      ts: Date.now(),
      dev: deviceIdRef.current,
      inv: compactInv,
      prv: previousShiftClosingMap,
      wrk: workers,
      att: attendanceLogs.slice(0, 40),
      snk: sinkingFunds,
      shf: shiftHistory.slice(0, 15),
      csh: actualCashInDrawer,
      qrs: qrisAmount,
      pty: pettyCashList,
    };
  };

  const applyCompactCloudPacket = (pkt) => {
    if (!pkt || pkt.v !== 19) return false;
    isApplyingRemoteRef.current = true;
    try {
      if (Array.isArray(pkt.inv)) {
        setInventory((prev) => {
          const mapById = new Map(pkt.inv.map((row) => [row[0], row]));
          return prev.map((item) => {
            const r = mapById.get(item.id);
            if (!r) return item;
            return {
              ...item,
              stockStart: Number(r[1]) || 0,
              stockIn: Number(r[2]) || 0,
              stockWaste: Number(r[3]) || 0,
              stockEnd: Number(r[4]) || 0,
              soldCount: Number(r[5]) || 0,
              cost: Number(r[6]) || 0,
              price: Number(r[7]) || 0,
              packCost: Number(r[8]) || 0,
              minStock: Number(r[9]) || 0,
              targetStock: Number(r[10]) || 0,
              name: r[11] || item.name,
              recipe: Array.isArray(r[12]) ? r[12] : item.recipe,
            };
          });
        });
      }
      if (pkt.prv) setPreviousShiftClosingMap(pkt.prv);
      if (Array.isArray(pkt.wrk)) setWorkers(pkt.wrk);
      if (Array.isArray(pkt.att)) setAttendanceLogs(pkt.att);
      if (Array.isArray(pkt.snk)) setSinkingFunds(pkt.snk);
      if (Array.isArray(pkt.shf)) setShiftHistory(pkt.shf);
      if (pkt.csh !== undefined) setActualCashInDrawer(Number(pkt.csh) || 0);
      if (pkt.qrs !== undefined) setQrisAmount(Number(pkt.qrs) || 0);
      if (Array.isArray(pkt.pty)) setPettyCashList(pkt.pty);

      setLastSyncTime(new Date().toLocaleTimeString('id-ID'));
      setSyncStatus('Real-Time Cloud Aktif');
      return true;
    } finally {
      setTimeout(() => {
        isApplyingRemoteRef.current = false;
      }, 400);
    }
  };

  const pushToCloud = async (manual = false) => {
    try {
      setSyncStatus('Mengirim...');
      const pkt = buildCompactCloudPacket();
      const bodyStr = JSON.stringify(pkt);
      const res = await fetch(`https://ntfy.sh/${encodeURIComponent(cloudRoom)}`, {
        method: 'POST',
        headers: { 'Content-Type': 'text/plain;charset=UTF-8' },
        body: bodyStr,
      });
      if (res.ok) {
        setLastSyncTime(new Date().toLocaleTimeString('id-ID'));
        setSyncStatus('Real-Time Cloud Aktif');
        if (manual) showToast(`☁️ Data berhasil dikirim ke semua HP & Laptop (${bodyStr.length} bytes)!`);
      } else {
        setSyncStatus('Gagal Kirim');
      }
    } catch {
      setSyncStatus('Mode Offline Lokal');
    }
  };

  const pullFromCloudNow = async (manual = false) => {
    try {
      setSyncStatus('Menarik Data...');
      const res = await fetch(`https://ntfy.sh/${encodeURIComponent(cloudRoom)}/json?poll=1&since=24h`);
      if (!res.ok) throw new Error('Gagal tarik');
      const text = await res.text();
      const lines = text.trim().split('\n').filter(Boolean);
      let latestPacket = null;
      for (let i = lines.length - 1; i >= 0; i--) {
        try {
          const env = JSON.parse(lines[i]);
          if (env && env.message) {
            const parsed = JSON.parse(env.message);
            if (parsed && parsed.v === 19) {
              latestPacket = parsed;
              break;
            }
          }
        } catch {
          // Lanjut baris berikutnya
        }
      }
      hasPulledInitialRef.current = true;
      if (latestPacket) {
        applyCompactCloudPacket(latestPacket);
        if (manual) showToast('📥 Data terbaru dari Cloud berhasil dimuat ke layar ini!');
      } else {
        setSyncStatus('Real-Time Cloud Aktif');
        if (manual) showToast('ℹ️ Belum ada kiriman baru di Cloud Room ini.');
      }
    } catch {
      hasPulledInitialRef.current = true;
      setSyncStatus('Mode Offline Lokal');
    }
  };

  useEffect(() => {
    pullFromCloudNow(false);
    let es = null;
    try {
      es = new EventSource(`https://ntfy.sh/${encodeURIComponent(cloudRoom)}/sse`);
      es.onmessage = (evt) => {
        try {
          const env = JSON.parse(evt.data);
          if (env && env.message) {
            const pkt = JSON.parse(env.message);
            if (pkt && pkt.v === 19 && pkt.dev !== deviceIdRef.current) {
              applyCompactCloudPacket(pkt);
            }
          }
        } catch {
          // Abaikan pesan bukan JSON
        }
      };
    } catch {
      // Fallback polling
    }
    return () => {
      if (es) es.close();
    };
  }, [cloudRoom]);

  // Auto-push setiap perubahan setelah pull awal selesai
  useEffect(() => {
    if (!hasPulledInitialRef.current || isApplyingRemoteRef.current) return;
    const timer = setTimeout(() => {
      pushToCloud(false);
    }, 900);
    return () => clearTimeout(timer);
  }, [inventory, workers, attendanceLogs, sinkingFunds, shiftHistory, actualCashInDrawer, qrisAmount, pettyCashList]);

  // ==========================================================================
  // KALKULASI RESEP OTOMATIS (AUTO-BOM), HPP, OMZET & AUDIT STOK
  // ==========================================================================
  const recipeUsageMap = useMemo(() => {
    const usage = {};
    inventory.forEach((item) => {
      if (item.isMenuRacikan && (Number(item.soldCount) || 0) > 0 && Array.isArray(item.recipe)) {
        const sold = Number(item.soldCount) || 0;
        item.recipe.forEach((r) => {
          const ingId = Number(r.ingredientId);
          const qtyUsed = Math.round(sold * (Number(r.qty) || 0) * 100) / 100;
          if (!usage[ingId]) usage[ingId] = { totalQty: 0, details: [] };
          usage[ingId].totalQty = Math.round((usage[ingId].totalQty + qtyUsed) * 100) / 100;
          usage[ingId].details.push(`${item.name} (${formatQty(qtyUsed)})`);
        });
      }
    });
    return usage;
  }, [inventory]);

  const menuRacikanList = useMemo(() => inventory.filter((i) => i.isMenuRacikan), [inventory]);
  const physicalStockList = useMemo(() => inventory.filter((i) => !i.isMenuRacikan), [inventory]);

  const shiftTotals = useMemo(() => {
    let omzetRacikan = 0;
    let hppRacikan = 0;
    let omzetFisik = 0;
    let hppFisik = 0;
    const soldItemsBreakdown = [];

    inventory.forEach((item) => {
      if (item.isMenuRacikan) {
        const sold = Math.max(0, Number(item.soldCount) || 0);
        const rev = sold * (Number(item.price) || 0);
        const cogs = sold * (Number(item.cost) || 0);
        omzetRacikan += rev;
        hppRacikan += cogs;
        if (sold > 0) {
          soldItemsBreakdown.push({
            id: item.id,
            name: item.name,
            category: item.category,
            sold,
            revenue: rev,
            cogs,
            profit: rev - cogs,
          });
        }
      } else {
        const totalAvailable = (Number(item.stockStart) || 0) + (Number(item.stockIn) || 0) - (Number(item.stockWaste) || 0);
        const usedInRecipe = recipeUsageMap[item.id]?.totalQty || 0;
        const rawDepleted = Math.max(0, totalAvailable - (Number(item.stockEnd) || 0));
        const directSold = Math.max(0, Math.round((rawDepleted - usedInRecipe) * 100) / 100);
        const rev = directSold * (Number(item.price) || 0);
        const cogs = directSold * (Number(item.cost) || 0);
        omzetFisik += rev;
        hppFisik += cogs;
        if (directSold > 0) {
          soldItemsBreakdown.push({
            id: item.id,
            name: item.name,
            category: item.category,
            sold: directSold,
            revenue: rev,
            cogs,
            profit: rev - cogs,
          });
        }
      }
    });

    const totalOmzet = omzetRacikan + omzetFisik;
    const totalHpp = hppRacikan + hppFisik;
    const grossProfit = totalOmzet - totalHpp;
    const totalPettyCash = pettyCashList.reduce((acc, p) => acc + (Number(p.amount) || 0), 0);
    const expectedCash = totalOmzet - totalPettyCash - (Number(qrisAmount) || 0);
    const cashDiscrepancy = (Number(actualCashInDrawer) || 0) - expectedCash;

    return {
      omzetRacikan,
      hppRacikan,
      omzetFisik,
      hppFisik,
      totalOmzet,
      totalHpp,
      grossProfit,
      totalPettyCash,
      expectedCash,
      cashDiscrepancy,
      soldItemsBreakdown,
    };
  }, [inventory, recipeUsageMap, pettyCashList, qrisAmount, actualCashInDrawer]);

  // Radar Manipulasi Stok Awal vs Stok Akhir Shift Sebelumnya
  const tamperedItems = useMemo(() => {
    return physicalStockList.filter((item) => {
      const prevEnd = previousShiftClosingMap[item.id];
      return prevEnd !== undefined && Number(item.stockStart) !== Number(prevEnd);
    });
  }, [physicalStockList, previousShiftClosingMap]);

  // Radar Stok Menipis & Kalkulator Estimasi Belanja Kulakan Owner
  const lowStockReport = useMemo(() => {
    const items = physicalStockList
      .filter((item) => (Number(item.minStock) || 0) > 0 && (Number(item.stockEnd) || 0) <= (Number(item.minStock) || 0))
      .map((item) => {
        const current = Number(item.stockEnd) || 0;
        const target = Math.max(Number(item.targetStock) || 20, (Number(item.minStock) || 5) * 3);
        const qtyToBuy = Math.max(1, Math.ceil(target - current));
        const unitCost = Number(item.cost) || Number(item.baseUnitCost) || 0;
        const estUnitTotal = qtyToBuy * unitCost;
        const estPackTotal = (Number(item.packCost) || 0) > 0 ? Number(item.packCost) : estUnitTotal;
        return {
          ...item,
          qtyToBuy,
          unitCost,
          estUnitTotal,
          estPackTotal,
        };
      });

    const totalEstUnit = items.reduce((s, i) => s + i.estUnitTotal, 0);
    const totalEstPack = items.reduce((s, i) => s + i.estPackTotal, 0);
    return { items, totalEstUnit, totalEstPack };
  }, [physicalStockList]);

  // ==========================================================================
  // PERINGKAT TOP 5 MENU PENYUMBANG PROFIT TERBESAR (SHIFT INI / 7 HARI / 30 HARI)
  // ==========================================================================
  const topProfitMenus = useMemo(() => {
    const mapAgg = new Map();
    const addBreakdown = (list) => {
      if (!Array.isArray(list)) return;
      list.forEach((b) => {
        const prev = mapAgg.get(b.name) || {
          name: b.name,
          category: b.category || '',
          sold: 0,
          revenue: 0,
          cogs: 0,
          profit: 0,
        };
        prev.sold = Math.round((prev.sold + (Number(b.sold) || 0)) * 100) / 100;
        prev.revenue += Number(b.revenue) || 0;
        prev.cogs += Number(b.cogs) || 0;
        prev.profit += Number(b.profit) || 0;
        mapAgg.set(b.name, prev);
      });
    };

    // Selalu sertakan shift berjalan saat ini
    addBreakdown(shiftTotals.soldItemsBreakdown);

    if (topSellerPeriod === 'weekly') {
      shiftHistory.slice(0, 14).forEach((s) => addBreakdown(s.soldItemsBreakdown));
    } else if (topSellerPeriod === 'monthly') {
      shiftHistory.slice(0, 60).forEach((s) => addBreakdown(s.soldItemsBreakdown));
    }

    const allSorted = Array.from(mapAgg.values()).sort((a, b) => b.profit - a.profit);
    const totalProfitAll = allSorted.reduce((s, x) => s + Math.max(0, x.profit), 0) || 1;
    const withShare = allSorted.map((x) => ({
      ...x,
      sharePct: Math.round((Math.max(0, x.profit) / totalProfitAll) * 100),
    }));

    const topFoods = withShare.filter((x) => !x.category.toLowerCase().includes('minuman')).slice(0, 5);
    const topDrinks = withShare.filter((x) => x.category.toLowerCase().includes('minuman')).slice(0, 5);

    return {
      topOverall: withShare.slice(0, 5),
      topFoods,
      topDrinks,
      totalProfitAll: allSorted.reduce((s, x) => s + x.profit, 0),
    };
  }, [shiftTotals.soldItemsBreakdown, shiftHistory, topSellerPeriod]);

  // ==========================================================================
  // REKAP GAJI & ABSENSI PEKERJA (TAB 3) + PEMBUKUAN 1 BULAN (TAB 4)
