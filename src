  const workerSummaryList = useMemo(() => {
    return workers.map((w) => {
      const logs = attendanceLogs.filter((l) => l.workerName === w.name);
      const hadirLogs = logs.filter((l) => l.status === 'Hadir');
      const alfaLogs = logs.filter((l) => l.status === 'Alfa');
      const izinLogs = logs.filter((l) => l.status === 'Izin' || l.status === 'Sakit');

      const totalGrossWage = hadirLogs.length * (Number(w.dailyWage) || 0);
      const totalDeductions = logs.reduce((s, l) => s + (Number(l.deduction) || 0), 0);
      const netWage = totalGrossWage - totalDeductions;

      return {
        ...w,
        hadirCount: hadirLogs.length,
        alfaCount: alfaLogs.length,
        izinCount: izinLogs.length,
        alfaDates: alfaLogs.map((a) => a.date),
        izinDates: izinLogs.map((a) => `${a.date} (${a.status})`),
        totalGrossWage,
        totalDeductions,
        netWage,
      };
    });
