  });
  const [newWorkerForm, setNewWorkerForm] = useState({ name: '', role: 'Penjaga Shift', dailyWage: 0 });
  const [newSinkingForm, setNewSinkingForm] = useState({ name: '', dailyTarget: 10000, monthlyTarget: 300000 });

  const deviceIdRef = useRef(`dev_${Math.random().toString(36).slice(2, 8)}`);
