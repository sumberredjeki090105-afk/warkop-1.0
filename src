                          monthlyTarget: 300000,
                        },
                      ])
                    }
                    className="px-4 py-2 rounded-xl bg-[#B91C1C] hover:bg-red-600 text-white font-black text-xs shadow"
                  >
                    + Tambah Pos Baru
                  </button>
                </div>

                <div className="space-y-3.5">
                  {sinkingFunds.map((fund) => (
                    <div
                      key={fund.id}
                      className="bg-[#1C1917] border border-stone-800 rounded-2xl p-4 space-y-3"
                    >
                      <div className="flex items-center justify-between gap-2">
                        <input
                          type="text"
                          value={fund.name}
                          onChange={(e) =>
                            setSinkingFunds((prev) =>
                              prev.map((f) => (f.id === fund.id ? { ...f, name: e.target.value } : f))
                            )
                          }
                          className="bg-transparent text-amber-400 font-black text-sm focus:outline-none flex-1"
                        />
                        <button
                          type="button"
                          onClick={() => setSinkingFunds((prev) => prev.filter((f) => f.id !== fund.id))}
                          className="text-stone-400 hover:text-rose-400 text-sm"
                          title="Hapus Pos"
                        >
                          🗑️
                        </button>
                      </div>

                      <div className="grid grid-cols-1 sm:grid-cols-2 gap-3">
                        <div>
                          <label className="text-xs text-stone-400 block text-center mb-1.5">
                            Setoran / Hari (Rp)
                          </label>
                          <input
                            type="number"
                            value={fund.dailyTarget}
                            onChange={(e) => {
                              const daily = Number(e.target.value) || 0;
                              setSinkingFunds((prev) =>
                                prev.map((f) =>
                                  f.id === fund.id
                                    ? { ...f, dailyTarget: daily, monthlyTarget: daily * 30 }
                                    : f
                                )
                              );
                            }}
                            className="w-full bg-[#110F0E] border border-stone-700/80 rounded-xl px-3.5 py-2.5 text-sm font-black text-white"
                          />
                        </div>
                        <div>
                          <label className="text-xs text-stone-400 block text-center mb-1.5">
                            Target Bulanan (Rp)
                          </label>
                          <input
                            type="number"
                            value={fund.monthlyTarget}
                            onChange={(e) => {
                              const monthly = Number(e.target.value) || 0;
                              setSinkingFunds((prev) =>
                                prev.map((f) =>
                                  f.id === fund.id
                                    ? { ...f, monthlyTarget: monthly, dailyTarget: Math.round(monthly / 30) }
                                    : f
                                )
                              );
                            }}
                            className="w-full bg-[#110F0E] border border-stone-700/80 rounded-xl px-3.5 py-2.5 text-sm font-black text-emerald-400"
                          />
                        </div>
                      </div>
                    </div>
                  ))}
                </div>
              </div>
            </section>
          )}
        </main>
      )}

      {/* ==================================================================== */}
      {/* MODAL EDIT MENU & RESEP OTOMATIS (KELIPATAN 0.5, 1, 1.5, 2)          */}
      {/* ==================================================================== */}
      {editingItem && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
          <div className="bg-[#1A1614] border-2 border-amber-500/50 rounded-3xl max-w-xl w-full p-5 space-y-4 shadow-2xl">
            <div className="flex items-center justify-between">
              <h3 className="text-base font-black text-amber-400">
                ✏️ Edit "{editingItem.name}" & Resep
              </h3>
              <button
                type="button"
                onClick={() => setEditingItem(null)}
                className="w-8 h-8 rounded-full bg-stone-800 text-stone-300 font-black"
              >
                ✕
              </button>
            </div>

            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs">
              <div>
                <label className="text-stone-400 block mb-1">Nama Menu / Barang</label>
                <input
                  type="text"
                  value={editingItem.name}
                  onChange={(e) => setEditingItem({ ...editingItem, name: e.target.value })}
                  className="w-full bg-stone-900 border border-stone-700 rounded-xl px-3 py-2 font-bold text-stone-100"
                />
              </div>
              <div>
                <label className="text-stone-400 block mb-1">Kategori</label>
                <input
                  type="text"
                  value={editingItem.category}
                  onChange={(e) => setEditingItem({ ...editingItem, category: e.target.value })}
                  className="w-full bg-stone-900 border border-stone-700 rounded-xl px-3 py-2 font-bold text-stone-100"
                />
              </div>
            </div>

            <div className="grid grid-cols-2 sm:grid-cols-4 gap-2.5 text-xs">
              <div>
                <label className="text-stone-400 block mb-1">Satuan</label>
                <input
                  type="text"
                  value={editingItem.unit}
                  onChange={(e) => setEditingItem({ ...editingItem, unit: e.target.value })}
                  className="w-full bg-stone-900 border border-stone-700 rounded-xl px-3 py-2 font-bold"
                />
              </div>
              <div>
                <label className="text-stone-400 block mb-1">Harga Grosir</label>
                <input
                  type="number"
                  value={editingItem.packCost || 0}
                  onChange={(e) => setEditingItem({ ...editingItem, packCost: Number(e.target.value) || 0 })}
                  className="w-full bg-stone-900 border border-stone-700 rounded-xl px-3 py-2 font-bold"
                />
              </div>
              <div>
                <label className="text-rose-400 block mb-1">HPP Akhir (Rp)</label>
                <input
                  type="number"
                  value={editingItem.cost}
                  onChange={(e) => setEditingItem({ ...editingItem, cost: Number(e.target.value) || 0 })}
                  className="w-full bg-stone-900 border border-rose-500/60 rounded-xl px-3 py-2 font-black text-rose-300"
                />
              </div>
              <div>
                <label className="text-amber-400 block mb-1">Harga Jual (Rp)</label>
                <input
                  type="number"
                  value={editingItem.price}
                  onChange={(e) => setEditingItem({ ...editingItem, price: Number(e.target.value) || 0 })}
                  className="w-full bg-stone-900 border border-amber-500/60 rounded-xl px-3 py-2 font-black text-amber-300"
                />
              </div>
            </div>

            {/* Pengaturan Resep Otomatis Potong Stok (Kelipatan 0.5 -> 1 -> 1.5 -> 2) */}
            <div className="bg-stone-950 border border-stone-800 rounded-2xl p-3.5 space-y-3">
              <label className="flex items-center gap-2 text-xs font-black text-amber-300 cursor-pointer">
                <input
                  type="checkbox"
                  checked={Boolean(editingItem.isMenuRacikan)}
                  onChange={(e) => setEditingItem({ ...editingItem, isMenuRacikan: e.target.checked })}
                  className="rounded text-amber-500"
                />
                <span>🍳 Apakah ini Menu Racikan / Campuran (Nasi Campur, Omlet, Josu)?</span>
              </label>

              {editingItem.isMenuRacikan && (
                <div className="space-y-2.5">
                  <div className="flex items-center justify-between">
                    <span className="text-[11px] text-stone-300">
                      Resep Otomatis Potong Stok (Kelipatan pas <b>0.5 ➔ 1 ➔ 1.5 ➔ 2</b>):
                    </span>
                    <button
                      type="button"
                      onClick={() =>
                        setEditingItem({
                          ...editingItem,
                          recipe: [...(editingItem.recipe || []), { ingredientId: 101, qty: 1 }],
                        })
                      }
                      className="px-3 py-1.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black"
                    >
                      + Tambah Bahan Resep
                    </button>
                  </div>

                  {(editingItem.recipe || []).map((r, idx) => (
                    <div key={idx} className="flex items-center gap-2">
                      <select
                        value={r.ingredientId}
                        onChange={(e) => {
                          const updated = [...editingItem.recipe];
                          updated[idx] = { ...updated[idx], ingredientId: Number(e.target.value) };
                          setEditingItem({ ...editingItem, recipe: updated });
                        }}
                        className="flex-1 bg-stone-900 border border-stone-700 rounded-xl px-2.5 py-2 text-xs text-stone-100"
                      >
                        {physicalStockList.map((ing) => (
                          <option key={ing.id} value={ing.id}>
                            {ing.name} ({ing.unit})
                          </option>
                        ))}
                      </select>

                      {/* Tombol -0.5, Input step 0.5, dan +0.5 */}
                      <div className="flex items-center bg-stone-900 border border-amber-500/60 rounded-xl overflow-hidden">
                        <button
                          type="button"
                          onClick={() => {
                            const updated = [...editingItem.recipe];
                            const currentQty = Math.round((Number(updated[idx].qty) || 1) * 2) / 2;
                            updated[idx] = { ...updated[idx], qty: Math.max(0.5, currentQty - 0.5) };
                            setEditingItem({ ...editingItem, recipe: updated });
                          }}
                          className="px-2.5 py-1.5 bg-stone-800 hover:bg-stone-700 text-amber-300 font-black text-xs"
                        >
                          -
                        </button>
                        <input
                          type="number"
                          min="0.5"
                          step="0.5"
                          value={r.qty}
                          onChange={(e) => {
                            const raw = String(e.target.value).replace(',', '.');
                            const val = Math.max(0.5, parseFloat(raw) || 0.5);
                            const updated = [...editingItem.recipe];
                            updated[idx] = { ...updated[idx], qty: val };
                            setEditingItem({ ...editingItem, recipe: updated });
                          }}
                          className="w-14 bg-transparent text-center text-xs font-black text-amber-300 focus:outline-none"
                        />
                        <button
                          type="button"
                          onClick={() => {
                            const updated = [...editingItem.recipe];
                            const currentQty = Math.round((Number(updated[idx].qty) || 0.5) * 2) / 2;
                            updated[idx] = { ...updated[idx], qty: currentQty + 0.5 };
                            setEditingItem({ ...editingItem, recipe: updated });
                          }}
                          className="px-2.5 py-1.5 bg-stone-800 hover:bg-stone-700 text-amber-300 font-black text-xs"
                        >
                          +
                        </button>
                      </div>

                      <button
                        type="button"
                        onClick={() => {
                          const updated = editingItem.recipe.filter((_, i) => i !== idx);
                          setEditingItem({ ...editingItem, recipe: updated });
                        }}
                        className="px-2.5 py-1.5 rounded-xl bg-rose-950 text-rose-300 text-xs font-black"
                      >
                        ✕
                      </button>
                    </div>
                  ))}
                </div>
              )}
            </div>

            <div className="flex justify-end gap-2 pt-2">
              <button
                type="button"
                onClick={() => setEditingItem(null)}
                className="px-4 py-2 rounded-xl bg-stone-800 text-stone-300 text-xs font-bold"
              >
                Batal
              </button>
              <button
                type="button"
                onClick={() => {
                  setInventory((prev) => prev.map((it) => (it.id === editingItem.id ? editingItem : it)));
                  setEditingItem(null);
                  showToast('💾 Perubahan menu & resep otomatis berhasil disimpan!');
                }}
                className="px-5 py-2 rounded-xl bg-amber-500 hover:bg-amber-400 text-stone-950 text-xs font-black"
              >
                💾 Simpan Perubahan
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ==================================================================== */}
      {/* MODAL TAMBAH MENU / BARANG BARU                                      */}
      {/* ==================================================================== */}
      {showAddMenuModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-[#1A1614] border-2 border-emerald-500/50 rounded-3xl max-w-md w-full p-5 space-y-4">
            <h3 className="text-base font-black text-emerald-400">+ Tambah Menu / Barang Baru</h3>
            <div className="space-y-3 text-xs">
              <input
                type="text"
                placeholder="Nama Menu / Barang"
                value={newMenuForm.name}
                onChange={(e) => setNewMenuForm({ ...newMenuForm, name: e.target.value })}
                className="w-full bg-stone-900 border border-stone-700 rounded-xl px-3 py-2 text-stone-100"
              />
              <div className="grid grid-cols-2 gap-2">
                <input
                  type="number"
                  placeholder="Modal HPP (Rp)"
                  value={newMenuForm.cost || ''}
                  onChange={(e) => setNewMenuForm({ ...newMenuForm, cost: Number(e.target.value) || 0 })}
                  className="bg-stone-900 border border-stone-700 rounded-xl px-3 py-2 text-rose-300"
                />
                <input
                  type="number"
                  placeholder="Harga Jual (Rp)"
                  value={newMenuForm.price || ''}
                  onChange={(e) => setNewMenuForm({ ...newMenuForm, price: Number(e.target.value) || 0 })}
                  className="bg-stone-900 border border-stone-700 rounded-xl px-3 py-2 text-amber-300"
                />
              </div>
              <label className="flex items-center gap-2 text-amber-300 font-bold">
                <input
                  type="checkbox"
                  checked={newMenuForm.isMenuRacikan}
                  onChange={(e) => setNewMenuForm({ ...newMenuForm, isMenuRacikan: e.target.checked })}
                />
                <span>Menu Racikan (Tanpa Stok Awal/Akhir)</span>
              </label>
            </div>
            <div className="flex justify-end gap-2">
              <button
                type="button"
                onClick={() => setShowAddMenuModal(false)}
                className="px-4 py-2 rounded-xl bg-stone-800 text-xs font-bold"
              >
                Batal
              </button>
              <button
                type="button"
                onClick={() => {
                  if (!newMenuForm.name.trim()) return;
                  setInventory((prev) => [
                    ...prev,
                    {
                      ...newMenuForm,
                      id: Date.now(),
                      no: prev.length + 1,
                      baseUnitCost: newMenuForm.cost,
                      soldCount: 0,
                      stockStart: 0,
                      stockIn: 0,
                      stockWaste: 0,
                      stockEnd: 0,
                    },
                  ]);
                  setShowAddMenuModal(false);
                  showToast('✅ Menu baru berhasil ditambahkan!');
                }}
                className="px-4 py-2 rounded-xl bg-emerald-600 text-white text-xs font-black"
              >
                Simpan
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ==================================================================== */}
      {/* MODAL DIAGNOSTIK CLOUD REAL-TIME (TES KONEKSI LAPTOP <-> HP)          */}
      {/* ==================================================================== */}
      {showCloudModal && (
        <div className="fixed inset-0 z-50 bg-black/80 backdrop-blur-sm flex items-center justify-center p-4">
          <div className="bg-[#1A1614] border-2 border-emerald-500/50 rounded-3xl max-w-lg w-full p-5 space-y-4">
            <div className="flex items-center justify-between">
              <h3 className="text-base font-black text-emerald-400">
                ☁️ Pengaturan & Tes Sinyal Cloud Real-Time (Laptop ↔ HP)
              </h3>
              <button
                type="button"
                onClick={() => setShowCloudModal(false)}
                className="w-8 h-8 rounded-full bg-stone-800 text-stone-300 font-black"
              >
                ✕
              </button>
            </div>

            <div className="space-y-2 text-xs">
              <label className="text-stone-400 block">Kode Ruangan Cloud Warkop (Harus Sama di Laptop & HP):</label>
              <input
                type="text"
                value={cloudRoom}
                onChange={(e) => setCloudRoom(e.target.value)}
                className="w-full bg-stone-900 border border-stone-700 rounded-xl px-3 py-2 font-black text-emerald-300"
              />
            </div>

            {cloudTestResult && (
              <div className="bg-stone-950 border border-emerald-500/40 rounded-xl p-3 text-xs text-emerald-300 font-bold">
                {cloudTestResult}
              </div>
            )}

            <div className="flex flex-wrap gap-2">
              <button
                type="button"
                onClick={async () => {
                  const start = Date.now();
                  await pushToCloud(false);
                  const ms = Date.now() - start;
                  const size = JSON.stringify(buildCompactCloudPacket()).length;
                  setCloudTestResult(`✅ Sinyal Cloud Terhubung! Ukuran Paket: ${size} bytes (< 4KB aman) • Kecepatan: ${ms} ms`);
                }}
                className="flex-1 py-2.5 rounded-xl bg-emerald-600 hover:bg-emerald-500 text-white text-xs font-black"
              >
                ⚡ Tes Sinyal Cloud Sekarang
              </button>
              <button
                type="button"
                onClick={() => pullFromCloudNow(true)}
                className="flex-1 py-2.5 rounded-xl bg-cyan-700 hover:bg-cyan-600 text-white text-xs font-black"
              >
                📥 Tarik Paksa dari Cloud
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ==================================================================== */}
      {/* MODAL PAKET PWA & PANDUAN PASANG DI GITHUB                           */}
      {/* ==================================================================== */}
      {showPwaModal && (
        <div className="fixed inset-0 z-50 bg-black/85 backdrop-blur-sm flex items-center justify-center p-4 overflow-y-auto">
          <div className="bg-[#1A1614] border-2 border-emerald-500/50 rounded-3xl max-w-3xl w-full p-5 space-y-4 max-h-[90vh] overflow-y-auto">
            <div className="flex items-center justify-between">
              <h3 className="text-base sm:text-lg font-black text-emerald-400">
                📲 Paket Progressive Web App (PWA) Mandiri & Panduan GitHub
              </h3>
              <button
                type="button"
                onClick={() => setShowPwaModal(false)}
                className="w-8 h-8 rounded-full bg-stone-800 text-stone-300 font-black"
              >
                ✕
              </button>
            </div>

            <div className="bg-stone-950 border border-cyan-500/40 rounded-2xl p-4 space-y-2 text-xs text-stone-300">
              <h4 className="font-black text-cyan-300">
                🐙 Langkah Cepat Pasang PWA di GitHub Anda:
              </h4>
              <ol className="list-decimal list-inside space-y-1">
                <li>
                  Tempel kode utama ini ke <code>src/App.jsx</code> di repositori GitHub Anda.
                </li>
                <li>
                  Buat file baru di GitHub bernama <code className="text-emerald-300 font-bold">public/manifest.json</code> lalu tempel isi Kotak #1 di bawah.
                </li>
                <li>
                  Buat file baru di GitHub bernama <code className="text-cyan-300 font-bold">public/service-worker.js</code> lalu tempel isi Kotak #2 di bawah.
                </li>
                <li>
                  Ganti isi file <code className="text-amber-300 font-bold">index.html</code> di GitHub dengan isi Kotak #3 di bawah.
                </li>
              </ol>
            </div>

            {/* 1. MANIFEST.JSON */}
            <div className="bg-stone-900 border border-stone-800 rounded-2xl p-3.5 space-y-2">
              <div className="flex items-center justify-between">
                <span className="text-xs font-black text-emerald-400">1. File: public/manifest.json</span>
                <button
                  type="button"
                  onClick={() => {
                    navigator.clipboard.writeText(JSON.stringify(getManifestJsonObject(), null, 2));
                    showToast('📋 Kode public/manifest.json berhasil disalin!');
                  }}
                  className="px-3 py-1 rounded-lg bg-emerald-600 text-white text-xs font-black"
                >
                  📋 Salin manifest.json
                </button>
              </div>
              <pre className="text-[10px] bg-stone-950 p-2.5 rounded-xl overflow-x-auto text-stone-300 max-h-32">
                {JSON.stringify(getManifestJsonObject(), null, 2)}
              </pre>
            </div>

            {/* 2. SERVICE-WORKER.JS */}
            <div className="bg-stone-900 border border-stone-800 rounded-2xl p-3.5 space-y-2">
              <div className="flex items-center justify-between">
                <span className="text-xs font-black text-cyan-400">2. File: public/service-worker.js</span>
                <button
                  type="button"
                  onClick={() => {
                    navigator.clipboard.writeText(SERVICE_WORKER_CODE);
                    showToast('📋 Kode public/service-worker.js berhasil disalin!');
                  }}
                  className="px-3 py-1 rounded-lg bg-cyan-600 text-white text-xs font-black"
                >
                  📋 Salin service-worker.js
                </button>
              </div>
              <pre className="text-[10px] bg-stone-950 p-2.5 rounded-xl overflow-x-auto text-stone-300 max-h-32">
                {SERVICE_WORKER_CODE}
              </pre>
            </div>

            {/* 3. INDEX.HTML */}
            <div className="bg-stone-900 border border-stone-800 rounded-2xl p-3.5 space-y-2">
              <div className="flex items-center justify-between">
                <span className="text-xs font-black text-amber-400">3. File: index.html</span>
                <button
                  type="button"
                  onClick={() => {
                    navigator.clipboard.writeText(INDEX_HTML_PWA_TEMPLATE);
                    showToast('📋 Kode index.html berhasil disalin!');
                  }}
                  className="px-3 py-1 rounded-lg bg-amber-500 text-stone-950 text-xs font-black"
                >
                  📋 Salin index.html
                </button>
              </div>
              <pre className="text-[10px] bg-stone-950 p-2.5 rounded-xl overflow-x-auto text-stone-300 max-h-32">
                {INDEX_HTML_PWA_TEMPLATE}
              </pre>
            </div>

            <div className="flex justify-end">
              <button
                type="button"
                onClick={() => setShowPwaModal(false)}
                className="px-5 py-2 rounded-xl bg-stone-800 text-stone-200 text-xs font-bold"
              >
                Tutup Jendela PWA
              </button>
            </div>
          </div>
        </div>
      )}
    </div>
  );
}
